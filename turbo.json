{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["vite-api-proxy.mts"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": [
        "API_HOST",
        "API_PORT",
        "CSRF_SECRET",
        "DATABASE_SCHEMA",
        "DATABASE_URL",
        "DINGTALK_CALLBACK_SECRET",
        "JOB_POLL_INTERVAL_MS",
        "MAINTENANCE_INTERVAL_MS",
        "MEDIA_ROOT",
        "NODE_ENV",
        "OAUTH_STATE_SECRET",
        "PRIVATE_EXPORT_ROOT",
        "PUBLIC_ORIGIN",
        "REDEEM_CODE_ACTIVE_KEY_ID",
        "REDEEM_CODE_KEYS",
        "TRUST_PROXY",
        "API_PROXY_TARGET",
        "WECHAT_APP_ID",
        "WECHAT_APP_SECRET",
        "WECHAT_TOKEN_ENCRYPTION_KEY"
      ]
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    }
  }
}
