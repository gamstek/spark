{
  "name": "@spark/api",
  "type": "module",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "node dist/src/main.js",
    "prebuild": "pnpm --filter @spark/contracts build",
    "build": "tsc -p tsconfig.json",
    "pretypecheck": "pnpm --filter @spark/contracts build",
    "typecheck": "tsc -p tsconfig.json --noEmit --pretty false && tsc -p tsconfig.test.json --pretty false",
    "lint": "eslint .",
    "test": "vitest run --config vitest.unit.config.ts --passWithNoTests",
    "pretest:integration": "pnpm --filter @spark/contracts build",
    "test:integration": "vitest run --config vitest.config.ts",
    "db:migrate": "tsx database/migrate.ts",
    "admin:create": "tsx database/seeds/create-admin.ts",
    "templates:check": "tsx scripts/check-template-compatibility.ts"
  },
  "dependencies": {
    "@spark/contracts": "workspace:*",
    "@spark/templates": "workspace:*",
    "@nestjs/common": "12.0.1",
    "@nestjs/core": "12.0.1",
    "@nestjs/platform-fastify": "12.0.1",
    "fastify": "5.12.3",
    "pg": "8.23.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "typeorm": "1.1.1",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/node": "26.4.1",
    "tsx": "4.23.13",
    "typescript": "6.0.3",
    "vitest": "5.0.0"
  }
}
