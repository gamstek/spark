NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=3000
# Optional remote backend override for Vite's /api proxy; otherwise uses API_HOST/API_PORT.
# API_PROXY_TARGET=http://127.0.0.1:3000
DATABASE_URL=postgresql://spark:spark_local@127.0.0.1:54329/spark_test
TEST_DATABASE_URL=postgresql://spark:spark_local@127.0.0.1:54329/spark_test
# Must match the browser origin exactly, including Vite's actual port.
PUBLIC_ORIGIN=http://localhost:5175
TRUST_PROXY=loopback
CSRF_SECRET=replace-with-at-least-32-random-bytes
OAUTH_STATE_SECRET=replace-with-at-least-32-random-bytes
WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_TOKEN_ENCRYPTION_KEY=replace-with-at-least-32-random-bytes
MEDIA_ROOT=var/media
PRIVATE_EXPORT_ROOT=private/exports
