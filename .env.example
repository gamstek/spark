# Optional. Runtime mode; defaults to non-production behavior when omitted.
# Use development locally, test in automated tests, and production on the server.
NODE_ENV=development

# Optional. API listen address and port; defaults are 127.0.0.1 and 3000.
# 127.0.0.1 is suitable for local development;
# the production container overrides API_HOST with 0.0.0.0.
API_HOST=127.0.0.1
API_PORT=3000

# Optional. Vite development proxy target. Leave commented to derive it from
# API_HOST and API_PORT.
# API_PROXY_TARGET=http://127.0.0.1:3000

# Required in production; optional locally with the shown default. PostgreSQL
# connection used by the API and integration tests. Tests refuse to
# run unless the database name contains "test". Production Compose uses the
# postgres service hostname; URL-encode special characters in the password.
DATABASE_URL=postgresql://spark:spark_local@127.0.0.1:54329/spark_test
# Optional. PostgreSQL schema; defaults to public.
DATABASE_SCHEMA=public

# Required in production; optional locally. Exact public browser origin using
# scheme + hostname + optional port, without a path or trailing slash. It is
# used for OAuth callbacks, CSRF checks and URLs.
PUBLIC_ORIGIN=http://localhost:5175
# Optional. Trusted reverse-proxy addresses. "loopback" is the local default;
# production Compose restricts this to its container network.
TRUST_PROXY=loopback

# Required in production. Application-generated secret for signing CSRF values.
# Run `pnpm env:generate-secrets`; this is not supplied by WeChat or DingTalk.
CSRF_SECRET=replace-with-at-least-32-random-bytes
# Required in production. Application-generated secret for signing one-time
# WeChat OAuth state. It must differ from CSRF_SECRET and remain stable.
OAUTH_STATE_SECRET=replace-with-another-32-random-bytes

# Required in production; supplied by WeChat. Official Account developer AppID,
# normally beginning with "wx". Obtain it from the Official Account admin
# console. This is not the gh_xxx original ID.
WECHAT_APP_ID=
# Required in production; supplied by WeChat. Secret paired with WECHAT_APP_ID.
# Never expose it to browser code, URLs, logs or source control.
WECHAT_APP_SECRET=
# Required in production. Application-generated secret used to encrypt cached
# WeChat access tokens. Generate it with `pnpm env:generate-secrets` and keep it
# stable when restoring the database or running multiple API nodes.
WECHAT_TOKEN_ENCRYPTION_KEY=replace-with-a-third-32-random-byte-secret

# Required in production. Application-generated Bearer secret shared with the
# DingTalk form HTTP automation. Generate it with `pnpm env:generate-secrets`
# and configure the same value in its Authorization request header.
DINGTALK_CALLBACK_SECRET=dingtalk-replace-with-random-value

# Required in production. ID of the active redemption-code encryption key.
# This is an internal label, not a WeChat or DingTalk identifier.
REDEEM_CODE_ACTIVE_KEY_ID=v1
# Required in production. JSON map of key IDs to Base64-encoded, exactly
# 32-byte AES keys. Generate the first key with `pnpm env:generate-secrets`.
# Retain old entries so previously issued redemption codes remain readable.
REDEEM_CODE_KEYS={"v1":"replace-with-base64-encoded-32-byte-key"}

# Optional. Local storage paths; production Compose uses persistent volumes.
MEDIA_ROOT=var/media
PRIVATE_EXPORT_ROOT=private/exports

# Optional with defaults: POSTGRES_DB and POSTGRES_USER. POSTGRES_PASSWORD is
# required in production. These initialize the container on its first start.
POSTGRES_DB=spark
POSTGRES_USER=spark
POSTGRES_PASSWORD=replace-with-a-strong-database-password

# Optional. Background processing intervals in milliseconds; defaults are
# 1000 (one second) and 3600000 (one hour).
JOB_POLL_INTERVAL_MS=1000
MAINTENANCE_INTERVAL_MS=3600000
