# Runtime mode. Use development locally, test in automated tests, and production on the server.
NODE_ENV=development

# API listen address and port. 127.0.0.1 is suitable for local development;
# the production container overrides API_HOST with 0.0.0.0.
API_HOST=127.0.0.1
API_PORT=3000

# Optional Vite development proxy target. Leave commented to derive it from
# API_HOST and API_PORT.
# API_PROXY_TARGET=http://127.0.0.1:3000

# PostgreSQL connection used by the API and integration tests. Tests refuse to
# run unless the database name contains "test". Production Compose uses the
# postgres service hostname; URL-encode special characters in the password.
DATABASE_URL=postgresql://spark:spark_local@127.0.0.1:54329/spark_test
# Optional PostgreSQL schema. Defaults to public.
DATABASE_SCHEMA=public

# Exact public browser origin: scheme + hostname + optional port, without a
# path or trailing slash. It is used for OAuth callbacks, CSRF checks and URLs.
PUBLIC_ORIGIN=http://localhost:5175
# Trusted reverse-proxy addresses. "loopback" is the local default; production
# Compose restricts this to its container network.
TRUST_PROXY=loopback

# Application-generated secret for signing CSRF values. This is not supplied by
# WeChat or DingTalk. Generate at least 32 random bytes and keep it private.
CSRF_SECRET=replace-with-at-least-32-random-bytes
# Application-generated secret for signing one-time WeChat OAuth state. It must
# be different from CSRF_SECRET and remain stable across API restarts.
OAUTH_STATE_SECRET=replace-with-another-32-random-bytes

# WeChat Official Account developer AppID, normally beginning with "wx". Obtain
# it from the Official Account admin console. This is not the gh_xxx original ID.
WECHAT_APP_ID=
# Secret paired with WECHAT_APP_ID in the Official Account admin console. Never
# expose it to browser code, URLs, logs or source control.
WECHAT_APP_SECRET=
# Application-generated secret used to encrypt cached WeChat access tokens in
# PostgreSQL. Keep the same value when restoring or running multiple API nodes.
WECHAT_TOKEN_ENCRYPTION_KEY=replace-with-a-third-32-random-byte-secret

# Application-generated Bearer secret shared only with the DingTalk form HTTP
# automation. Configure the same value in its Authorization request header.
DINGTALK_CALLBACK_SECRET=replace-with-a-fourth-32-random-byte-secret

# ID of the active redemption-code encryption key. This is an internal label,
# not a WeChat or DingTalk identifier.
REDEEM_CODE_ACTIVE_KEY_ID=v1
# JSON map of key IDs to Base64-encoded, exactly 32-byte AES keys. Retain old
# entries after rotation so previously issued redemption codes remain readable.
REDEEM_CODE_KEYS={"v1":"replace-with-base64-encoded-32-byte-key"}

# Local storage paths. Production Compose replaces them with persistent volumes.
MEDIA_ROOT=var/media
PRIVATE_EXPORT_ROOT=private/exports

# PostgreSQL container settings used by compose.production.yaml.
POSTGRES_DB=spark
POSTGRES_USER=spark
POSTGRES_PASSWORD=replace-with-a-strong-database-password

# Optional background processing intervals in milliseconds.
JOB_POLL_INTERVAL_MS=1000
MAINTENANCE_INTERVAL_MS=3600000
