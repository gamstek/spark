# 可选。运行模式；未配置时默认采用非生产环境行为。
# 本地使用 development，自动化测试使用 test，服务器使用 production。
NODE_ENV=development

# 可选。活动 H5 浏览器模式。仅在本地 Vite 开发时设为 simulate，
# 以便普通浏览器创建模拟微信会话。
# 即使设置了该值，生产构建也会忽略此模式。
VITE_WECHAT_MODE=

# 生产环境必填。活动身份模式；匿名活动必须明确配置为 anonymous。
# 同一浏览器的活动会话 Cookie 最长保存 7 天；清除 Cookie 或更换设备会建立新会话，
# 不能用它跨设备限制同一用户重复参与。
ACTIVITY_IDENTITY_MODE=anonymous

# 可选。API 监听地址和端口；默认值分别为 127.0.0.1 和 3000。
# 127.0.0.1 适合本地开发；
# 生产容器会将 API_HOST 覆盖为 0.0.0.0。
API_HOST=127.0.0.1
API_PORT=3000

# 可选。Vite 开发代理目标。保持注释状态时，将根据 API_HOST 和 API_PORT 推导。
# API_PROXY_TARGET=http://127.0.0.1:3000

# 生产环境必填；本地可选，默认值如下。API 和集成测试使用的 PostgreSQL 连接。
# 数据库名称不包含 "test" 时，测试会拒绝运行。生产 Compose 使用 postgres
# 服务主机名；密码中的特殊字符需要进行 URL 编码。
DATABASE_URL=postgresql://spark:spark_local@127.0.0.1:54329/spark_test
# 可选。PostgreSQL schema；默认为 public。
DATABASE_SCHEMA=public

# 可选。受信任的反向代理地址。本地默认值为 "loopback"；
# 生产 Compose 会将其限制为容器网络。
TRUST_PROXY=loopback

# 生产环境必填。由应用生成，用于签名 CSRF 值的密钥。
# 运行 `pnpm env:generate-secrets` 生成；该值不是由微信或钉钉提供的。
CSRF_SECRET=replace-with-at-least-32-random-bytes
# 生产环境必填。由应用生成，用于签名一次性微信 OAuth state 的密钥。
# 该值必须与 CSRF_SECRET 不同，并保持稳定。
OAUTH_STATE_SECRET=replace-with-another-32-random-bytes

# 生产环境必填，由微信提供。微信公众号开发者 AppID，通常以 "wx" 开头。
# 请从公众号管理后台获取；这不是以 gh_xxx 开头的公众号原始 ID。
WECHAT_APP_ID=
# 生产环境必填，由微信提供。与 WECHAT_APP_ID 配套的密钥。
# 切勿将其暴露在浏览器代码、URL、日志或版本控制中。
WECHAT_APP_SECRET=
# 生产环境必填。由应用生成，用于加密缓存的微信 access token。
# 使用 `pnpm env:generate-secrets` 生成；恢复数据库或运行多个 API 节点时，
# 必须保持该值不变。
WECHAT_TOKEN_ENCRYPTION_KEY=replace-with-a-third-32-random-byte-secret

# 生产环境必填。由应用生成，与钉钉表单 HTTP 自动化共享的 Bearer 密钥。
# 使用 `pnpm env:generate-secrets` 生成，并在其 Authorization 请求头中配置相同值。
DINGTALK_CALLBACK_SECRET=dingtalk-replace-with-random-value

# 生产环境必填。当前启用的兑奖码加密密钥 ID。
# 这是内部标签，不是微信或钉钉标识符。
REDEEM_CODE_ACTIVE_KEY_ID=v1
# 生产环境必填。密钥 ID 到 Base64 编码的 32 字节 AES 密钥的 JSON 映射。
# 使用 `pnpm env:generate-secrets` 生成第一个密钥。
# 保留旧条目，确保此前签发的兑奖码仍可读取。
REDEEM_CODE_KEYS={"v1":"replace-with-base64-encoded-32-byte-key"}

# 可选。本地存储路径；生产 Compose 使用持久化卷。
MEDIA_ROOT=var/media
PRIVATE_EXPORT_ROOT=private/exports

# POSTGRES_DB 和 POSTGRES_USER 可选并带有默认值；生产环境必须配置
# POSTGRES_PASSWORD。这些配置用于容器首次启动时的初始化。
POSTGRES_DB=spark
POSTGRES_USER=spark
POSTGRES_PASSWORD=replace-with-a-strong-database-password

# 可选。后台处理间隔，单位为毫秒；默认值分别为 1000（1 秒）和
# 3600000（1 小时）。
JOB_POLL_INTERVAL_MS=1000
MAINTENANCE_INTERVAL_MS=3600000
