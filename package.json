{
  "name": "spark",
  "private": true,
  "packageManager": "pnpm@10.15.1",
  "engines": {
    "node": ">=24.11.0 <25"
  },
  "scripts": {
    "env:generate-secrets": "node scripts/generate-env-secrets.mjs",
    "dev": "node --env-file-if-exists=.env node_modules/turbo/bin/turbo run dev --parallel",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:integration": "pnpm --filter @spark/api test:integration",
    "db:test:start": "node scripts/start-test-postgres.mjs",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm test:integration"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "embedded-postgres"
    ]
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "26.4.1",
    "embedded-postgres": "18.4.0-beta.17",
    "eslint": "10.0.1",
    "prettier": "3.9.6",
    "turbo": "2.10.12",
    "typescript": "6.0.3",
    "typescript-eslint": "8.69.0",
    "vitest": "5.0.0"
  }
}
